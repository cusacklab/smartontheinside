<?xml version="1.0" encoding="utf-8"?>
<aap>
    <tasklist>
        <initialisation>
            <module><name>aamod_checkparameters</name></module>
            <module><name>aamod_study_init</name></module>
            <module><name>aamod_newsubj_init</name></module>
        </initialisation>
        <main>
            <module><name>aamod_autoidentifyseries_timtrio</name></module> 
            <module><name>aamod_get_dicom_diffusion</name></module> 
            <module><name>aamod_convert_diffusion_phaseencode_direction</name></module>
            <module><name>aamod_diffusion_extractnodif</name></module>
            <module><name>aamod_diffusion_topup</name></module>
            <module><name>aamod_bet_diffusion</name></module>
            
            <module><name>aamod_diffusion_eddy</name></module>
            
            <module><name>aamod_diffusion_dtifit</name></module>
            <module><name>aamod_get_dicom_structural</name></module>
            <module><name>aamod_convert_structural</name></module>
            <module><name>aamod_coreg_structural2fa</name></module>
            <module><name>aamod_norm_noss_diffusion_session</name></module>
            
            <module><name>aamod_diffusion_bedpostx</name></module>
            
            <!-- Tractography --> 
            <module>
                <name>aamod_unnormalise_seeds</name>   
                <extraparameters>
                    <aap><tasklist><currenttask><settings>
                                    <rois>
                                        <roi>
                                            <filename>hcp_regions_target.nii</filename>
                                            <low>1</low>
                                            <high>1</high>
                                            <labelled_map>1</labelled_map>
                                        </roi>
                                    </rois>
                                    <roi_path>/imaging/rcusack/laura_ffa_diffusion/rois</roi_path>
                    </settings></currenttask></tasklist></aap>
                </extraparameters>
            </module>      
            <!--    targets and seeds are the same but with different regions selected         <module>
                <name>aamod_unnormalise_targets</name>
            </module>
     -->     
            <module><name>aamod_diffusion_probtrackx</name></module>
            <module><name>aamod_diffusion_probtrackxsummarize_indv</name></module>
            <module><name>aamod_diffusion_probtrackxsummarize_group</name></module>

            <!-- don't move this earlier without making sure aamod_unnormalise_seeds and aamod_diffusion_probtrackx don't pick up wDTI_FA rather than DTI_FA -->
            <module><name>aamod_norm_write_diffusion_session</name></module>

        </main>
    </tasklist>
</aap>
